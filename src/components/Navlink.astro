---
interface Props {
	label: string;
	href: string;
	class?: string;
}
const { label, href }: Props = Astro.props;
---

<li>
	<a
		href={href}
		class="nav-link group relative font-mono text-micro uppercase py-2 tracking-wider"
		style="color: var(--fg-subtle); transition: color 150ms var(--ease-out);"
	>
		{label}
		<span
			class="nav-underline absolute bottom-0 left-0 w-full h-px origin-left"
			style="background-color: var(--accent); transform: scaleX(0); transition: transform 200ms var(--ease-out);"
		></span>
	</a>
</li>

<style>
	@media (hover: hover) and (pointer: fine) {
		.nav-link:hover {
			color: var(--fg) !important;
		}
		.nav-link:hover .nav-underline {
			transform: scaleX(1);
		}
	}
	.nav-link:active {
		transform: scale(0.98);
	}
</style>
