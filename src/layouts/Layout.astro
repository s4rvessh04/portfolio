---
import "../styles/global.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import Navbar from "../components/Navbar.astro";

import { SITE_TITLE, SITE_DESCRIPTION, SITE_NAME, RESUME_URL } from "../config";

export interface Props {
	title?: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<GoogleAnalytics />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={SITE_DESCRIPTION} />
		<meta name="author" content="Sarvesh Rane" />
		<meta name="keywords" content="backend engineer, Node.js, Go, Golang, distributed systems, REST API, microservices, Kafka, Redis, PostgreSQL, MySQL, Docker, Kubernetes, RBAC, ABAC, OpenTelemetry, Prometheus, Nginx, Azure DevOps, ELK Stack, JWT, software engineer, Jio Platforms, India, Navi Mumbai, Pune, open to work" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
		<!-- Geo / local SEO -->
		<meta name="geo.region" content="IN-MH" />
		<meta name="geo.placename" content="Navi Mumbai, Maharashtra, India" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Preload critical assets -->
		<link rel="preload" as="image" href="/profile.webp" fetchpriority="high" />

		<!-- Font loading: Geist Sans + Geist Mono via Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>

		<!-- DNS prefetch for third-party domains -->
		<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
		<link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />

		<meta name="generator" content={Astro.generator} />
		<title>{title ? title : SITE_TITLE}</title>
		<link rel="canonical" href={Astro.url} />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Sarvesh Rane",
			"url": "https://sarveshrane.pages.dev",
			"jobTitle": "Software Engineer I — Backend",
			"description": "Backend Engineer with 2+ years of experience at Jio Platforms delivering high-throughput, zero-downtime enterprise systems. Specializes in Node.js microservices, RBAC/ABAC security models, and distributed data stores. Also builds in Go: a 1,185 RPS L4 load balancer and a Kafka Transactional Outbox service.",
			"worksFor": {
				"@type": "Organization",
				"name": "Jio Platforms Ltd.",
				"url": "https://www.jio.com"
			},
			"sameAs": [
				"https://github.com/s4rvessh04",
				"https://linkedin.com/in/sarvesh-rane-80452522a",
				"https://twitter.com/sarvessh_/"
			],
			"alumniOf": {
				"@type": "CollegeOrUniversity",
				"name": "Smt. Kashibai Navale College of Engineering, Pune"
			},
			"knowsAbout": [
				"Node.js", "Express.js", "Backend Development", "REST API Design", "Microservices",
				"Go", "Golang", "Distributed Systems",
				"Apache Kafka", "Transactional Outbox Pattern",
				"Redis", "PostgreSQL", "MySQL", "MongoDB",
				"RBAC", "ABAC", "JWT", "Access Control",
				"Layer 4 Load Balancing", "TCP", "UDP",
				"Docker", "Kubernetes", "Azure DevOps", "CI/CD", "Nginx",
				"Prometheus", "Grafana", "OpenTelemetry", "ELK Stack",
				"Python", "Django", "FastAPI",
				"TypeScript", "JavaScript", "HonoJS",
				"DevOps", "Linux", "Sequelize", "Swagger", "OpenAPI"
			]
		})} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title ? title : SITE_TITLE} />
		<meta property="og:description" content={SITE_DESCRIPTION} />
		<meta property="og:image" content={new URL("/og-card.png", Astro.url)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Sarvesh Rane — Backend Engineer | Node.js, Go, Distributed Systems" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title ? title : SITE_TITLE} />
		<meta property="twitter:description" content={SITE_DESCRIPTION} />
		<meta property="twitter:image" content={new URL("/og-card.png", Astro.url)} />
		<meta property="twitter:creator" content="@sarvessh_" />
	</head>
	<body
		class="min-h-screen antialiased overflow-x-hidden"
		style="background-color: var(--canvas); color: var(--text-ink);"
	>
		<!-- Skip to content — keyboard accessibility -->
		<a
			href="#main-content"
			class="fixed top-0 left-0 z-[200] px-4 py-2 text-sm font-medium -translate-y-full focus:translate-y-0"
			style="background: var(--ink); color: #fff; transition: transform 200ms var(--ease-out); border-radius: 0 0 var(--rounded-sm) 0;"
		>
		Skip to content
		</a>
		<!-- Google Tag Manager (noscript) -->
		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-WW9MXB4S"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe>
		</noscript>

		<Navbar />
		<main id="main-content" class="relative z-[3]" aria-label="Page content">
			<slot />
		</main>

		<!-- Status bar — Geist-inspired bottom bar -->
		<div
			id="status-bar"
			class="fixed bottom-0 left-0 right-0 z-[90] hidden md:flex items-center justify-between px-6 lg:px-8"
			style="height: 28px; background: var(--canvas-elevated); border-top: 1px solid var(--hairline); font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.05em; color: var(--text-mute); opacity: 0; transform: translateY(100%); transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);"
		>
			<div class="flex items-center gap-4">
				<span class="flex items-center gap-1.5">
					<span class="w-1.5 h-1.5 rounded-full animate-pulse-slow" style="background: #22c55e;"></span>
					<span class="uppercase" style="color: var(--text-body);">online</span>
				</span>
				<span style="color: var(--hairline);">│</span>
				<span id="status-section" class="uppercase" style="color: var(--text-body);">hero</span>
			</div>
			<div class="flex items-center gap-4">
				<span id="status-scroll" class="tabular-nums">ln 0</span>
				<span style="color: var(--hairline);">│</span>
				<span id="status-time" class="tabular-nums uppercase"></span>
			</div>
		</div>

		<style is:global>
			/* ============================================
			   SCROLL REVEAL SYSTEM
			   ============================================ */
			.reveal {
				opacity: 0;
				transform: translateY(20px);
				transition:
					opacity 0.55s cubic-bezier(0.16, 1, 0.3, 1),
					transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.reveal.revealed {
				opacity: 1;
				transform: translateY(0);
			}

			/* Line reveal — clean horizontal wipe */
			.line-reveal {
				height: 1px;
				background: var(--hairline);
				transform: scaleX(0);
				transform-origin: left;
				transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.line-reveal.revealed {
				transform: scaleX(1);
			}

			/* Stagger delays */
			.stagger-1 { transition-delay: 0.06s; }
			.stagger-2 { transition-delay: 0.12s; }
			.stagger-3 { transition-delay: 0.18s; }
			.stagger-4 { transition-delay: 0.24s; }
			.stagger-5 { transition-delay: 0.30s; }
			.stagger-6 { transition-delay: 0.36s; }
			.stagger-7 { transition-delay: 0.42s; }
			.stagger-8 { transition-delay: 0.48s; }

			/* Scrollbar */
			::-webkit-scrollbar { width: 0px; }
			html { scrollbar-width: none; }

			/* NAV — transitions only after entry animation */
			#main-nav.nav-ready {
				transition:
					background-color 200ms var(--ease-out),
					backdrop-filter 200ms var(--ease-out),
					-webkit-backdrop-filter 200ms var(--ease-out),
					border-color 200ms var(--ease-out);
			}

			/* @starting-style — modern entry animations */
			@starting-style {
				.reveal { opacity: 0; transform: translateY(20px); }
				.line-reveal { transform: scaleX(0); }
			}

			/* Status bar bottom padding */
			@media (min-width: 768px) {
				body { padding-bottom: 28px; }
			}
		</style>

		<!-- Page entry animation — no loader, straight into content -->
		<script>
			import { createTimeline, stagger } from "animejs";

			// ── Page entry animation — immediate, cascading ──
			function animatePageEntry() {
				const entryTl = createTimeline({
					defaults: { ease: "outQuart" },
				});

				entryTl
					.add("#main-nav", {
						opacity: [0, 1],
						translateY: [-12, 0],
						duration: 500,
					})
					.add(".hero-animate:first-of-type", {
						opacity: [0, 1],
						translateY: [24, 0],
						duration: 700,
					}, "-=350")
					.add(".hero-animate:not(:first-of-type)", {
						opacity: [0, 1],
						translateY: [16, 0],
						duration: 500,
						delay: stagger(60),
					}, "-=500")
					.add(".hero-scroll-indicator", {
						opacity: [0, 1],
						translateY: [12, 0],
						duration: 500,
					}, "-=200");

				// Animate status bar in after page loads
				setTimeout(() => {
					const bar = document.getElementById("status-bar");
					if (bar) {
						bar.style.opacity = "1";
						bar.style.transform = "translateY(0)";
					}
				}, 800);
			}

			// Start immediately on load
			animatePageEntry();
		</script>

		<!-- Status bar logic -->
		<script>
			// Update time
			function updateStatusTime() {
				const el = document.getElementById("status-time");
				if (el) {
					const now = new Date();
					el.textContent =
						now.toLocaleTimeString("en-US", {
							hour: "2-digit",
							minute: "2-digit",
							second: "2-digit",
							hour12: false,
							timeZone: "Asia/Kolkata",
						}) + " IST";
				}
			}
			updateStatusTime();
			setInterval(updateStatusTime, 1000);

			// Update section and scroll position
			const sections = [
				{ id: "hero-section", label: "hero" },
				{ id: "work-section", label: "deployments" },
				{ id: "skills-section", label: "dependencies" },
				{ id: "about-section", label: "readme" },
			];

			function updateStatusBar() {
				const scrollEl = document.getElementById("status-scroll");
				const sectionEl = document.getElementById("status-section");

				if (scrollEl) {
					const pct = Math.round(
						(window.scrollY /
							(document.documentElement.scrollHeight - window.innerHeight)) *
							100
					);
					scrollEl.textContent = `ln ${pct}%`;
				}

				if (sectionEl) {
					let current = sections[0].label;
					for (const s of sections) {
						const el = document.getElementById(s.id);
						if (el && el.getBoundingClientRect().top <= window.innerHeight / 2) {
							current = s.label;
						}
					}
					sectionEl.textContent = current;
				}
			}

			window.addEventListener("scroll", updateStatusBar, { passive: true });
			updateStatusBar();
		</script>

		<!-- Scroll reveal observer -->
		<script>
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add("revealed");
							observer.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.08, rootMargin: "0px 0px -60px 0px" }
			);

			document.querySelectorAll(".reveal, .line-reveal").forEach((el) => observer.observe(el));
		</script>

		<!-- Cloudflare Web Analytics -->
		<script
			defer
			src="https://static.cloudflareinsights.com/beacon.min.js"
			data-cf-beacon='{"token": "f1b03c7ad51b497aad9e6f45fc464a8f"}'
		></script>
	</body>
</html>
