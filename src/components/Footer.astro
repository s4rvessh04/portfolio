---
import { socialLinks } from "../data";
---

<footer
	class="relative"
	aria-label="Footer"
	style="border-top: 1px solid var(--hairline); background: var(--canvas); overflow: hidden;"
>
	<!-- Bottom ticker — exit telemetry -->
	<div class="ticker-wrapper" aria-hidden="true" style="border-top: none;">
		<div class="ticker" style="animation-duration: 40s;">
			<div class="ticker-group">
				<span class="eyebrow">open to work</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">navi mumbai · ist (utc+5:30)</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">backend engineering</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">uptime matters</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">say hello ↗</span>
				<span class="ticker-sep">▸</span>
			</div>
			<div class="ticker-group" aria-hidden="true">
				<span class="eyebrow">open to work</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">navi mumbai · ist (utc+5:30)</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">backend engineering</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">uptime matters</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">say hello ↗</span>
				<span class="ticker-sep">▸</span>
			</div>
		</div>
	</div>

	<!-- Exit statement -->
	<div class="cta-band" style="padding: var(--space-4xl) var(--space-lg); border: none; border-radius: 0; background: var(--canvas); text-align: left;">
		<div style="max-width: 1200px; margin: 0 auto;">
			<p class="eyebrow reveal" style="margin: 0 0 var(--space-lg) 0;">// 05 — exit</p>

			<a
				href="mailto:sarveshrane2000.dev@gmail.com"
				class="exit-wordmark reveal stagger-1"
				aria-label="Email Sarvesh Rane"
			>
				sarvesh<span class="exit-dot">.</span>dev<span class="exit-arrow" aria-hidden="true">↗</span>
			</a>

			<div class="exit-meta reveal stagger-2" style="margin-top: var(--space-md);">
				<span class="exit-status-dot" aria-hidden="true"></span>
				<span>open to work</span>
				<span class="exit-meta-sep" aria-hidden="true">/</span>
				<span>navi mumbai, ist</span>
			</div>

			<!-- Links row -->
			<div class="reveal stagger-3" style="margin-top: var(--space-xl); padding-top: var(--space-lg); border-top: 1px solid var(--hairline); display: flex; flex-wrap: wrap; gap: var(--space-sm) var(--space-md); align-items: center;">
				<nav aria-label="Footer navigation" style="display: flex; flex-wrap: wrap; gap: var(--space-sm) var(--space-md);">
					<a href="#" class="footer-link exit-nav-link" aria-label="Back to top">top</a>
					<a href="#work-section" class="footer-link exit-nav-link">work</a>
					<a href="#experience-section" class="footer-link exit-nav-link">experience</a>
					<a href="#skills-section" class="footer-link exit-nav-link">stack</a>
					<a href="#about-section" class="footer-link exit-nav-link">about</a>
				</nav>
				<span class="exit-meta-sep" aria-hidden="true">/</span>
				<div style="display: flex; flex-wrap: wrap; gap: var(--space-xs);">
					{socialLinks.map((social) => (
						<a
							href={social.link}
							target="_blank"
							rel="noopener noreferrer me"
							class="social-chip"
						>
							<span class="social-chip-label">{social.title}</span>
							<span class="social-chip-arrow" aria-hidden="true">↗</span>
						</a>
					))}
				</div>
			</div>

			<!-- Bottom row -->
			<div style="margin-top: var(--space-xl); display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-md); justify-content: space-between;">
				<p class="eyebrow" style="margin: 0; color: var(--text-faint);">
					&copy; {new Date().getFullYear()} Sarvesh Rane
				</p>
				<p class="eyebrow" style="margin: 0; color: var(--text-faint);" title="Deployed with Cloudflare Pages Git integration">
					built on cloudflare pages · edge-deployed
				</p>
			</div>
		</div>
	</div>
</footer>

<style>
	.exit-wordmark {
		display: block;
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: clamp(2.5rem, 10vw + 0.5rem, 10rem);
		line-height: 0.95;
		letter-spacing: -0.05em;
		color: var(--text-ink);
		text-decoration: none;
		white-space: nowrap;
		transition: color 200ms var(--ease-out);
	}
	.exit-wordmark:hover {
		color: var(--accent);
	}
	.exit-dot {
		color: var(--accent);
		transition: color 200ms var(--ease-out);
	}
	.exit-wordmark:hover .exit-dot {
		color: var(--text-ink);
	}
	.exit-arrow {
		font-size: 0.35em;
		vertical-align: 0.9em;
		margin-left: 0.08em;
		color: var(--accent);
		transition: transform 200ms var(--ease-out);
	}
	.exit-wordmark:hover .exit-arrow {
		transform: translate(0.12em, -0.12em);
	}
	.exit-meta {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		letter-spacing: 0.02em;
		color: var(--text-body);
		display: flex;
		align-items: center;
		gap: var(--space-sm);
	}
	.exit-meta-sep {
		color: var(--text-faint);
	}
	.exit-status-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--status-green);
		display: inline-block;
		animation: pulse-dot 2s ease-in-out infinite;
	}
	.exit-nav-link {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		letter-spacing: 0.02em;
		position: relative;
		padding-left: 14px;
	}
	.exit-nav-link::before {
		content: "▸";
		position: absolute;
		left: 0;
		color: var(--accent);
		opacity: 0;
		transition: opacity 150ms var(--ease-out);
	}
	.exit-nav-link:hover {
		color: var(--accent);
	}
	.exit-nav-link:hover::before {
		opacity: 1;
	}
	@keyframes pulse-dot {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.4; }
	}
	@media (prefers-reduced-motion: reduce) {
		.exit-status-dot {
			animation: none;
		}
	}
</style>
