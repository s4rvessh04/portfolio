---
/**
 * DotIcon — renders a doticon SVG inline with currentColor inheritance.
 * Icons are from https://github.com/eduardconstantin/doticons
 * 
 * Usage: <DotIcon name="github" size={20} />
 */
export interface Props {
	name: string;
	size?: number;
	class?: string;
}

const { name, size = 20, class: className } = Astro.props;

// Map of available doticons (raw SVG imports)
const icons: Record<string, () => Promise<{ default: string }>> = {
	github: () => import('../icons/github.svg?raw'),
	linkedin: () => import('../icons/linkedin.svg?raw'),
	instagram: () => import('../icons/instagram.svg?raw'),
	x: () => import('../icons/x.svg?raw'),
	gmail: () => import('../icons/gmail.svg?raw'),
	weblink: () => import('../icons/weblink.svg?raw'),
	arrowRight: () => import('../icons/arrowRight.svg?raw'),
};

const loader = icons[name];
let svgContent = '';
if (loader) {
	const mod = await loader();
	// Inject width/height and class into the SVG
	svgContent = mod.default
		.replace(/<svg /, `<svg width="${size}" height="${size}" class="${className || ''}" aria-hidden="true" `)
}
---

<Fragment set:html={svgContent} />
