---
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
import {
	benchmarks,
	projects,
	socialLinks,
	skills,
	professionalSummary,
	careerStartDate,
	experience,
} from "../data";
---

<Layout>
	<!-- HERO — Signal: dot grid, one scan sweep, decoded name -->
	<section id="hero-section" class="hero">
		<div class="signal-grid" aria-hidden="true"></div>
		<div class="signal-sweep" aria-hidden="true"></div>
		<div class="hero-inner">
			<div class="hero-content">
				<p class="eyebrow hero-animate">// backend engineer — navi mumbai</p>
				<h1 class="hero-title hero-animate">
					<span data-decode="SARVESH RANE">SARVESH RANE</span><span class="hero-cursor" aria-hidden="true">_</span>
				</h1>
				<p class="hero-tagline hero-animate">Building backend systems that handle real traffic — and shipping them to production.</p>
				<p class="hero-status hero-animate">
					<span class="status-dot" aria-hidden="true"></span> open to work <span class="status-sep">·</span> navi mumbai, IST
				</p>
				<div class="hero-actions hero-animate">
					<a href="mailto:sarveshrane2000@gmail.com" class="btn-primary">Get in touch ↗</a>
					<a href="#work-section" class="btn-secondary">View work</a>
				</div>
			</div>
			<div class="hero-telemetry telemetry" aria-label="Selected benchmarks">
				{benchmarks.map((b) => (
					<span><b>{b.value}</b> {b.unit} <span class="telemetry-label">{b.label}</span></span>
				))}
			</div>
		</div>
	</section>

	<!-- TICKER — skills strip -->
	<div class="ticker-wrapper" aria-hidden="true" role="presentation">
		<div class="ticker">
			<div class="ticker-group">
				<span class="eyebrow">systems engineering</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">backend development</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">infrastructure</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">devops</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">open source</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">go · python · javascript</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">docker · kubernetes · kafka</span>
				<span class="ticker-sep">▸</span>
			</div>
			<div class="ticker-group" aria-hidden="true">
				<span class="eyebrow">systems engineering</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">backend development</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">infrastructure</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">devops</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">open source</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">go · python · javascript</span>
				<span class="ticker-sep">▸</span>
				<span class="eyebrow">docker · kubernetes · kafka</span>
				<span class="ticker-sep">▸</span>
			</div>
		</div>
	</div>

	<!-- PROJECTS -->
	<section id="work-section" style="padding: var(--space-section) var(--space-lg); scroll-margin-top: 64px;">
		<div style="max-width: 1200px; margin: 0 auto;">
			<!-- Section header -->
			<div style="margin-bottom: var(--space-3xl);">
				<div class="reveal" style="margin-bottom: var(--space-md);">
					<span class="eyebrow">// 01 — selected work</span>
				</div>
				<div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
					<h2 class="reveal stagger-1" style="font-family: var(--font-sans); font-size: clamp(1.75rem, 3vw + 0.5rem, 2.5rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.04em; color: var(--text-ink); margin: 0;">
						Work
					</h2>
					<p class="reveal stagger-2" style="font-size: 0.9375rem; color: var(--text-body); max-width: 380px; line-height: 1.6; margin: 0;">
						Things I've built — some for work, some just because I was curious.
					</p>
				</div>
			</div>

			<!-- Project list — hairline rows -->
			<div role="list">
				{projects.map((project, idx) => (
					<div>
						<div class="line-reveal" style={`transition-delay: ${idx * 0.04}s;`}></div>
						<div
							class:list={["project-row group reveal", `stagger-${idx + 1}`]}
							role="listitem"
						>
							<div class="flex flex-col gap-3">
								<!-- Index + title row -->
								<div class="flex items-baseline gap-4">
									<span class="project-index eyebrow">
										{String(idx + 1).padStart(2, "0")}
									</span>
									<h3 style="font-family: var(--font-sans); font-size: 1.5rem; font-weight: 600; letter-spacing: -0.03em; color: var(--text-ink); margin: 0; display: inline-flex; align-items: center; gap: 8px;">
										{project.title}
										<span class="project-arrow" aria-hidden="true">↗</span>
									</h3>
								</div>

								<!-- Description -->
								<p class="pl-0 md:pl-9" style="font-size: 0.9375rem; color: var(--text-body); line-height: 1.6; max-width: 560px; margin: 0;">
									{project.description}
								</p>

								<!-- Stack tags -->
								{project.stack && project.stack.length > 0 && (
									<div class="pl-0 md:pl-9" style="display: flex; flex-wrap: wrap; gap: 6px;">
										{project.stack.map((tech) => (
											<span class="stack-tag">
												{tech}
											</span>
										))}
									</div>
								)}

								<!-- Action links -->
								<div class="pl-0 md:pl-9" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 4px;">
									<a
										href={project.github}
										target="_blank"
										rel="noopener noreferrer"
										class="btn-nav project-link"
									>
										<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
											<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
										</svg>
										Source
									</a>
									{project.live && (
										<a
											href={project.live}
											target="_blank"
											rel="noopener noreferrer"
											class="btn-nav project-link"
										>
											<span style="width: 6px; height: 6px; border-radius: 50%; background: var(--status-green); display: inline-block; flex-shrink: 0;"></span>
											Live
										</a>
									)}
								</div>
							</div>

							<!-- Project image — subtle, hairline-bordered -->
							<div class="mt-5 overflow-hidden project-image-frame" style="border: 1px solid var(--hairline); border-radius: var(--rounded-md);">
								<div class="relative overflow-hidden" style="aspect-ratio: 16/9;">
									<img
										src={project.image}
										alt={`${project.title} preview`}
										width="800"
										height="450"
										class="project-image project-image-light w-full h-full object-cover"
										loading="eager"
										decoding="async"
									/>
									<img
										src={project.imageDark}
										alt={`${project.title} preview`}
										width="800"
										height="450"
										class="project-image project-image-dark w-full h-full object-cover"
										loading="eager"
										decoding="async"
									/>
									<div class="project-scan" aria-hidden="true"></div>
									<div class="project-image-overlay" aria-hidden="true"></div>
									<span class="project-view" aria-hidden="true">view ↗</span>
									<div class="reticle" aria-hidden="true">
										<span class="reticle-corner reticle-tl"></span>
										<span class="reticle-corner reticle-br"></span>
									</div>
								</div>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- EXPERIENCE -->
	<section id="experience-section" style="padding: var(--space-section) var(--space-lg); scroll-margin-top: 64px;">
		<div style="max-width: 1200px; margin: 0 auto;">
			<div style="margin-bottom: var(--space-3xl);">
				<div class="reveal" style="margin-bottom: var(--space-md);">
					<span class="eyebrow">// 02 — experience</span>
				</div>
				<h2 class="reveal stagger-1" style="font-family: var(--font-sans); font-size: clamp(1.75rem, 3vw + 0.5rem, 2.5rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.04em; color: var(--text-ink); margin: 0;">
					Work History
				</h2>
			</div>

			<!-- Timeline -->
			<div role="list">
				{experience.map((job, idx) => (
					<div>
						<div class="line-reveal" style={`transition-delay: ${idx * 0.04}s;`}></div>
						<div
							class:list={["exp-row reveal", `stagger-${idx + 1}`]}
							role="listitem"
							style="padding: var(--space-xl) 0 var(--space-xl) 20px; display: flex; gap: var(--space-2xl); flex-wrap: wrap; position: relative;"
						>
							<div class="reticle" aria-hidden="true">
								<span class="reticle-corner reticle-tl"></span>
								<span class="reticle-corner reticle-br"></span>
							</div>
							<!-- Left: period + location -->
							<div style="min-width: 160px; flex-shrink: 0;">
								<p class="eyebrow exp-period" style="margin: 0 0 4px 0; display: flex; align-items: center; gap: 6px;">
									{job.period.includes("Present") && <span class="status-dot" aria-hidden="true"></span>}
									{job.period}
								</p>
								<p style="font-size: 0.8125rem; color: var(--text-mute); margin: 0;">{job.location}</p>
							</div>
							<!-- Right: role details -->
							<div style="flex: 1; min-width: 260px;">
								<h3 style="font-family: var(--font-sans); font-size: 1.375rem; font-weight: 600; letter-spacing: -0.025em; color: var(--text-ink); margin: 0 0 2px 0;">
									{job.role}
								</h3>
								<p style="font-size: 0.9375rem; color: var(--accent); margin: 0 0 var(--space-md) 0;">{job.company}</p>
								<ul style="margin: 0 0 var(--space-md) 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px;">
									{job.highlights.map((h) => (
										<li style="font-size: 0.9375rem; color: var(--text-body); line-height: 1.6; display: flex; gap: 8px;">
											<span style="color: var(--accent); flex-shrink: 0; margin-top: 2px;">▸</span>
											{h}
										</li>
									))}
								</ul>
								<!-- Stack tags -->
								<div style="display: flex; flex-wrap: wrap; gap: 6px;">
									{job.stack.map((tech) => (
										<span class="stack-tag">
											{tech}
										</span>
									))}
								</div>
							</div>
						</div>
					</div>
				))}
				<div class="line-reveal stagger-4"></div>
			</div>
		</div>
	</section>

	<!-- SKILLS — hairline feature-card grid -->
	<section id="skills-section" style="padding: var(--space-section) var(--space-lg); background: var(--hairline-soft);">
		<div style="max-width: 1200px; margin: 0 auto;">
			<div class="reveal" style="margin-bottom: var(--space-md);">
				<span class="eyebrow">// 03 — stack</span>
			</div>
			<h2 class="reveal stagger-1" style="font-family: var(--font-sans); font-size: clamp(1.75rem, 3vw + 0.5rem, 2.5rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.04em; color: var(--text-ink); margin: 0 0 var(--space-3xl) 0;">
				Stack
			</h2>

			<!-- 2-up hairline card grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4" role="list">
				{skills.map((skillGroup, groupIdx) => (
					<div
						class:list={["feature-card skill-card reveal", `stagger-${groupIdx + 1}`]}
						role="listitem"
					>
						<p class="eyebrow" style="margin-bottom: var(--space-md);">
							{skillGroup.title}
						</p>
						<div style="display: flex; flex-wrap: wrap; gap: 6px;" role="list">
							{skillGroup.data.map((skill) => (
								<span
									class="stack-tag"
									role="listitem"
								>
									{skill.title}
								</span>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ABOUT -->
	<section id="about-section" style="padding: var(--space-section) var(--space-lg); scroll-margin-top: 64px;">
		<div style="max-width: 1200px; margin: 0 auto;">
			<div class="reveal" style="margin-bottom: var(--space-md);">
				<span class="eyebrow">// 04 — about</span>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16">
				<!-- Photo column -->
				<div class="md:col-span-4 reveal">
					<div class="about-photo">
						<div class="signal-grid" aria-hidden="true"></div>
						<img
							src="/profile.webp"
							alt="Sarvesh Rane"
							width="1159"
							height="1160"
							loading="lazy"
							decoding="async"
							class="profile-img"
						/>
					</div>

					<!-- Stat pills -->
					<div class="grid grid-cols-2 gap-3 mt-4 reveal stagger-2">
						<div class="feature-card" style="padding: var(--space-md);">
							<p class="eyebrow" style="margin-bottom: 4px;">Experience</p>
							<p class="stat-value">
								{(() => {
									const start = new Date(careerStartDate);
									const now = new Date();
									const diff = now.getTime() - start.getTime();
									const diffDate = new Date(diff);
									const years = Math.abs(diffDate.getUTCFullYear() - 1970);
									const months = diffDate.getUTCMonth();
									return `${years}y ${months}m`;
								})()}
							</p>
						</div>
						<div class="feature-card" style="padding: var(--space-md);">
							<p class="eyebrow" style="margin-bottom: 4px;">CGPA</p>
							<p class="stat-value">8.69 / 10</p>
						</div>
					</div>
				</div>

				<!-- Bio column -->
				<div class="md:col-span-8 flex flex-col justify-center">
					<h2 class="reveal" style="font-family: var(--font-sans); font-size: clamp(1.75rem, 3vw + 0.5rem, 2.5rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.04em; color: var(--text-ink); margin: 0 0 var(--space-xl) 0;">
						Backend Engineer.<br class="inline" /> Building production systems<br class="hidden sm:inline" /> since 2023.
					</h2>

					<div class="line-reveal stagger-2" style="margin-bottom: var(--space-xl);"></div>

					<div class="reveal stagger-3">
						<p style="font-size: 1rem; line-height: 1.75; color: var(--text-body); max-width: 540px; margin: 0 0 var(--space-xl) 0;">
							{professionalSummary}
						</p>
					</div>

					<div class="feature-card reveal stagger-4" style="max-width: 440px;">
						<p class="eyebrow" style="margin-bottom: var(--space-xs);">Education</p>
						<p style="font-size: 0.9375rem; font-weight: 500; color: var(--text-ink); letter-spacing: -0.01em; margin: 0 0 2px 0;">Smt. Kashibai Navale College of Engineering</p>
						<p style="font-size: 0.875rem; color: var(--text-body); margin: 0 0 2px 0;">B.E. Electronics &amp; Telecommunications (Hons. Data Science) · 2019–2023</p>
						<p style="font-size: 0.875rem; color: var(--text-mute); margin: 0;">CGPA 8.69 / 10 · Pune, Maharashtra</p>
					</div>

					<!-- Social links -->
					<div class="flex flex-wrap gap-2 mt-8 reveal stagger-5">
						{socialLinks.map((social) => (
							<a
								href={social.link}
								target="_blank"
								rel="noopener noreferrer"
								class="btn-nav social-link"
							>
								{social.title}
							</a>
						))}
					</div>
				</div>
			</div>
		</div>
	</section>

	<Footer />
</Layout>

<style>
	/* Social / project link hover */
	.social-link, .project-link {
		transition: border-color 150ms var(--ease-out), background 150ms var(--ease-out), color 150ms var(--ease-out);
	}
	@media (hover: hover) and (pointer: fine) {
		.social-link:hover, .project-link:hover {
			color: var(--text-ink) !important;
			border-color: var(--hover-border) !important;
			background: var(--hairline-soft) !important;
		}
	}
</style>

<script>
	const target = document.querySelector<HTMLElement>("[data-decode]");
	const final = target?.dataset.decode ?? "";

	if (
		target &&
		final &&
		!window.matchMedia("(prefers-reduced-motion: reduce)").matches
	) {
		const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/#%&";
		let frame = 0;
		const total = 26;
		const timer = window.setInterval(() => {
			const progress = frame / total;
			target.textContent = Array.from(final, (ch, i) =>
				ch === " " || i < progress * final.length
					? ch
					: chars[Math.floor(Math.random() * chars.length)]
			).join("");
			frame += 1;
			if (frame > total) {
				window.clearInterval(timer);
				target.textContent = final;
			}
		}, 38);
	}
</script>
