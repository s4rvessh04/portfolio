---
import "../styles/global.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import Navbar from "../components/Navbar.astro";

import { SITE_TITLE, SITE_DESCRIPTION, SITE_NAME } from "../config";

export interface Props {
	title?: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<GoogleAnalytics />
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={SITE_DESCRIPTION} />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#09090b" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<!-- Font loading: preconnect + stylesheet -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Work+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap"
			rel="stylesheet"
		/>

		<!-- DNS prefetch for third-party domains -->
		<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
		<link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />

		<meta name="generator" content={Astro.generator} />
		<title>{title ? title : SITE_TITLE}</title>
		<link rel="canonical" href={Astro.url} />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Sarvesh Rane",
			"url": "https://sarveshrane.pages.dev",
			"jobTitle": "Software Engineer",
			"sameAs": [
				"https://github.com/s4rvessh04",
				"https://linkedin.com/in/sarvesh-rane-80452522a",
				"https://twitter.com/sarvessh_/"
			],
			"alumniOf": {
				"@type": "CollegeOrUniversity",
				"name": "Smt. Kashibai Navale College of Engineering, Pune"
			},
			"knowsAbout": ["Backend Development", "DevOps", "Go", "Python", "JavaScript", "Docker", "Kubernetes"]
		})} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title ? title : SITE_TITLE} />
		<meta property="og:description" content={SITE_DESCRIPTION} />
		<meta
			property="og:image"
			content={new URL("/profile.webp", Astro.url)}
		/>

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title ? title : SITE_TITLE} />
		<meta property="twitter:description" content={SITE_DESCRIPTION} />
		<meta
			property="twitter:image"
			content={new URL("/profile.webp", Astro.url)}
		/>
	</head>
	<body
		class="min-h-screen antialiased overflow-x-hidden"
	>
		<!-- Skip to content — keyboard accessibility -->
		<a
			href="#main-content"
			class="fixed top-0 left-0 z-[200] px-4 py-2 text-sm font-medium -translate-y-full focus:translate-y-0"
			style="background: var(--accent); color: #fff; transition: transform 200ms var(--ease-out);"
		>
		Skip to content
		</a>
		<!-- Google Tag Manager (noscript) -->
		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-WW9MXB4S"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe>
		</noscript>

		<Navbar />
		<main id="main-content" class="relative z-[3]" aria-label="Page content">
			<slot />
		</main>

		<!-- Status bar — tmux-inspired bottom bar -->
		<div
			id="status-bar"
			class="fixed bottom-0 left-0 right-0 z-[90] hidden md:flex items-center justify-between px-6 lg:px-8 font-mono"
			style="height: 28px; background: var(--bg-elevated); border-top: 1px solid var(--border-strong); font-size: 0.625rem; letter-spacing: 0.05em; color: var(--fg-subtle); opacity: 0; transform: translateY(100%); transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out);"
		>
			<div class="flex items-center gap-4">
				<span class="flex items-center gap-1.5">
					<span class="w-1.5 h-1.5 rounded-full animate-pulse-slow" style="background: var(--accent);"></span>
					<span class="uppercase" style="color: var(--accent);">online</span>
				</span>
				<span style="color: var(--fg-faint);">│</span>
				<span id="status-section" class="uppercase">hero</span>
			</div>
			<div class="flex items-center gap-4">
				<span id="status-scroll" class="tabular-nums">ln 0</span>
				<span style="color: var(--fg-faint);">│</span>
				<span id="status-time" class="tabular-nums uppercase"></span>
			</div>
		</div>

		<style is:global>
			/* ============================================
			   SCROLL REVEAL SYSTEM — smooth fade + rise
			   ============================================ */
			.reveal {
				opacity: 0;
				transform: translateY(24px);
				transition:
					opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
					transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
			}

			.reveal.revealed {
				opacity: 1;
				transform: translateY(0);
			}

			/* Line reveal — clean horizontal wipe */
			.line-reveal {
				height: 1px;
				background: var(--border-strong);
				transform: scaleX(0);
				transform-origin: left;
				transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
			}

			.line-reveal.revealed {
				transform: scaleX(1);
			}

			/* Stagger delays — perceptible but snappy (60ms between items) */
			.stagger-1 { transition-delay: 0.06s; }
			.stagger-2 { transition-delay: 0.12s; }
			.stagger-3 { transition-delay: 0.18s; }
			.stagger-4 { transition-delay: 0.24s; }
			.stagger-5 { transition-delay: 0.30s; }
			.stagger-6 { transition-delay: 0.36s; }
			.stagger-7 { transition-delay: 0.42s; }
			.stagger-8 { transition-delay: 0.48s; }

			/* Scrollbar */
			::-webkit-scrollbar {
				width: 0px;
			}
			html {
				scrollbar-width: none;
			}

			/* ============================================
			   NAV — transitions only after entry animation
			   ============================================ */
			#main-nav.nav-ready {
				transition: background-color 200ms var(--ease-out),
					backdrop-filter 200ms var(--ease-out),
					-webkit-backdrop-filter 200ms var(--ease-out),
					border-color 200ms var(--ease-out);
			}

			/* ============================================
			   @starting-style — modern entry animations
			   ============================================ */
			@starting-style {
				.reveal {
					opacity: 0;
					transform: translateY(24px);
				}
				.line-reveal {
					transform: scaleX(0);
				}
			}

			/* ============================================
			   STATUS BAR — bottom padding for content
			   ============================================ */
			@media (min-width: 768px) {
				body {
					padding-bottom: 28px;
				}
			}
		</style>

		<!-- Page entry animation — no loader, straight into content -->
		<script>
			import { createTimeline, stagger } from "animejs";

			// ── Page entry animation — immediate, cascading ──
			function animatePageEntry() {
				const entryTl = createTimeline({
					defaults: { ease: "outQuart" },
				});

				entryTl
					.add("#main-nav", {
						opacity: [0, 1],
						translateY: [-12, 0],
						duration: 500,
					})
					.add(".hero-animate:first-of-type", {
						opacity: [0, 1],
						translateY: [24, 0],
						duration: 700,
					}, "-=350")
					.add(".hero-animate:not(:first-of-type)", {
						opacity: [0, 1],
						translateY: [16, 0],
						duration: 500,
						delay: stagger(60),
					}, "-=500")
					.add(".hero-scroll-indicator", {
						opacity: [0, 1],
						translateY: [12, 0],
						duration: 500,
					}, "-=200");

				// Animate status bar in after page loads
				setTimeout(() => {
					const bar = document.getElementById("status-bar");
					if (bar) {
						bar.style.opacity = "1";
						bar.style.transform = "translateY(0)";
					}
				}, 800);
			}

			// Start immediately on load
			animatePageEntry();
		</script>

		<!-- Status bar logic -->
		<script>
			// Update time
			function updateStatusTime() {
				const el = document.getElementById("status-time");
				if (el) {
					const now = new Date();
					el.textContent =
						now.toLocaleTimeString("en-US", {
							hour: "2-digit",
							minute: "2-digit",
							second: "2-digit",
							hour12: false,
							timeZone: "Asia/Kolkata",
						}) + " IST";
				}
			}
			updateStatusTime();
			setInterval(updateStatusTime, 1000);

			// Update section and scroll position
			const sections = [
				{ id: "hero-section", label: "hero" },
				{ id: "work-section", label: "deployments" },
				{ id: "skills-section", label: "dependencies" },
				{ id: "about-section", label: "readme" },
			];

			function updateStatusBar() {
				const scrollEl = document.getElementById("status-scroll");
				const sectionEl = document.getElementById("status-section");

				if (scrollEl) {
					const pct = Math.round(
						(window.scrollY /
							(document.documentElement.scrollHeight - window.innerHeight)) *
							100
					);
					scrollEl.textContent = `ln ${pct}%`;
				}

				if (sectionEl) {
					let current = sections[0].label;
					for (const s of sections) {
						const el = document.getElementById(s.id);
						if (el && el.getBoundingClientRect().top <= window.innerHeight / 2) {
							current = s.label;
						}
					}
					sectionEl.textContent = current;
				}
			}

			window.addEventListener("scroll", updateStatusBar, { passive: true });
			updateStatusBar();
		</script>

		<!-- Scroll reveal observer -->
		<script>
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add("revealed");
							observer.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.08, rootMargin: "0px 0px -60px 0px" }
			);

			document.querySelectorAll(".reveal, .line-reveal").forEach((el) => observer.observe(el));
		</script>

		<!-- Cloudflare Web Analytics -->
		<script
			defer
			src="https://static.cloudflareinsights.com/beacon.min.js"
			data-cf-beacon='{"token": "f1b03c7ad51b497aad9e6f45fc464a8f"}'
		></script>
	</body>
</html>
