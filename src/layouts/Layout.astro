---
import "../styles/global.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import Navbar from "../components/Navbar.astro";

import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

export interface Props {
	title?: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
	<head>
		<GoogleAnalytics />
		<script>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({
					"gtm.start": new Date().getTime(),
					event: "gtm.js",
				});
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != "dataLayer" ? "&l=" + l : "";
				j.async = true;
				j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, "script", "dataLayer", "GTM-WW9MXB4S");
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={SITE_DESCRIPTION} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@200;300;400;500;600&family=Syne:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title ? title : SITE_TITLE}</title>
	</head>
	<body
		class="bg-black text-white min-h-screen antialiased selection:bg-white selection:text-black overflow-x-hidden"
	>
		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-WW9MXB4S"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe>
		</noscript>

		<!-- ===========================
		     PAGE LOADER — HUD Reticle
		     =========================== -->
		<div
			id="page-loader"
			class="fixed inset-0 z-[100] bg-black flex flex-col items-center justify-center pointer-events-auto"
		>
			<div class="loader-scanlines"></div>
			<div class="relative flex flex-col items-center">
				<svg
					id="hud-reticle"
					width="120"
					height="120"
					viewBox="0 0 120 120"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
					style="opacity: 0;"
				>
					<circle
						id="hud-ring-outer"
						cx="60"
						cy="60"
						r="56"
						stroke="rgba(255,255,255,0.15)"
						stroke-width="0.5"
						stroke-dasharray="352"
						stroke-dashoffset="352"></circle>
					<circle
						id="hud-ring-inner"
						cx="60"
						cy="60"
						r="40"
						stroke="rgba(255,255,255,0.25)"
						stroke-width="0.5"
						stroke-dasharray="251"
						stroke-dashoffset="251"></circle>
					<line
						id="hud-cross-h"
						x1="20"
						y1="60"
						x2="100"
						y2="60"
						stroke="rgba(255,255,255,0.2)"
						stroke-width="0.5"
						stroke-dasharray="80"
						stroke-dashoffset="80"></line>
					<line
						id="hud-cross-v"
						x1="60"
						y1="20"
						x2="60"
						y2="100"
						stroke="rgba(255,255,255,0.2)"
						stroke-width="0.5"
						stroke-dasharray="80"
						stroke-dashoffset="80"></line>
					<path
						id="hud-bracket-tl"
						d="M25 40 L25 25 L40 25"
						stroke="white"
						stroke-width="1"
						fill="none"
						opacity="0"></path>
					<path
						id="hud-bracket-tr"
						d="M80 25 L95 25 L95 40"
						stroke="white"
						stroke-width="1"
						fill="none"
						opacity="0"></path>
					<path
						id="hud-bracket-bl"
						d="M25 80 L25 95 L40 95"
						stroke="white"
						stroke-width="1"
						fill="none"
						opacity="0"></path>
					<path
						id="hud-bracket-br"
						d="M80 95 L95 95 L95 80"
						stroke="white"
						stroke-width="1"
						fill="none"
						opacity="0"></path>
					<circle
						id="hud-center-dot"
						cx="60"
						cy="60"
						r="2"
						fill="white"
						opacity="0"></circle>
				</svg>
				<div class="mt-8 flex flex-col items-center gap-3">
					<p
						id="hud-status"
						class="text-micro uppercase text-white/40 tracking-[0.4em] font-light"
						style="opacity: 0;"
					>
						Initializing
					</p>
					<div
						id="hud-progress-track"
						class="w-32 h-px bg-white/[0.06] relative overflow-hidden"
						style="opacity: 0;"
					>
						<div
							id="hud-progress-fill"
							class="absolute inset-y-0 left-0 bg-white/50"
							style="width: 0%;"
						>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Noise texture (global, subtle) -->
		<div
			class="fixed inset-0 pointer-events-none z-[2] opacity-[0.02]"
			style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 512 512%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');"
		>
		</div>

		<Navbar />
		<main class="relative z-[3]">
			<slot />
		</main>

		<style is:global>
			/* ============================================
			   HERO GRID — contained to hero section only
			   ============================================ */
			.hero-grid {
				position: absolute;
				inset: 0;
				pointer-events: none;
				z-index: 0;
			}
			.hero-grid-lines {
				position: absolute;
				inset: 0;
				background-image: linear-gradient(
						to right,
						rgba(255, 255, 255, 0.05) 1px,
						transparent 1px
					),
					linear-gradient(
						to bottom,
						rgba(255, 255, 255, 0.05) 1px,
						transparent 1px
					);
				background-size: 80px 80px;
				mask-image: radial-gradient(
					ellipse 70% 60% at 50% 40%,
					black 30%,
					transparent 70%
				);
				-webkit-mask-image: radial-gradient(
					ellipse 70% 60% at 50% 40%,
					black 30%,
					transparent 70%
				);
			}
			.hero-grid-glow {
				position: absolute;
				inset: 0;
			}

			/* ============================================
			   LOADER — HUD scanlines
			   ============================================ */
			.loader-scanlines {
				position: absolute;
				inset: 0;
				pointer-events: none;
				background: repeating-linear-gradient(
					0deg,
					transparent,
					transparent 2px,
					rgba(255, 255, 255, 0.008) 2px,
					rgba(255, 255, 255, 0.008) 4px
				);
				z-index: 1;
			}

			/* ============================================
			   SCROLL REVEAL SYSTEM
			   ============================================ */
			.reveal {
				opacity: 0;
				transform: translateY(50px);
				transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1),
					transform 1s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.reveal.revealed {
				opacity: 1;
				transform: translateY(0);
			}

			/* Stagger delays */
			.stagger-1 {
				transition-delay: 0.05s;
			}
			.stagger-2 {
				transition-delay: 0.1s;
			}
			.stagger-3 {
				transition-delay: 0.15s;
			}
			.stagger-4 {
				transition-delay: 0.2s;
			}
			.stagger-5 {
				transition-delay: 0.25s;
			}
			.stagger-6 {
				transition-delay: 0.3s;
			}
			.stagger-7 {
				transition-delay: 0.35s;
			}
			.stagger-8 {
				transition-delay: 0.4s;
			}

			/* Horizontal line animation */
			.line-reveal {
				height: 1px;
				background: rgba(255, 255, 255, 0.08);
				transform: scaleX(0);
				transform-origin: left;
				transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
			}
			.line-reveal.revealed {
				transform: scaleX(1);
			}

			/* Scrollbar */
			::-webkit-scrollbar {
				width: 0px;
			}
			html {
				scrollbar-width: none;
			}
		</style>

		<!-- HUD Loader animation (anime.js) -->
		<script>
			import { createTimeline, stagger, steps } from "animejs";

			const loader = document.getElementById("page-loader");

			const loaderTl = createTimeline({
				defaults: { ease: "outExpo" },
				onComplete: () => {
					if (loader) {
						loader.style.display = "none";
						loader.style.pointerEvents = "none";
					}
				},
			});

			loaderTl
				.add("#hud-reticle", {
					opacity: [0, 1, 0.3, 1],
					duration: 500,
					ease: "inOutQuad",
				})
				.add(
					"#hud-ring-outer",
					{
						strokeDashoffset: [352, 0],
						duration: 800,
						ease: "inOutQuart",
					},
					"-=200"
				)
				.add(
					"#hud-ring-inner",
					{
						strokeDashoffset: [251, 0],
						duration: 600,
						ease: "outQuart",
					},
					"-=500"
				)
				.add(
					["#hud-cross-h", "#hud-cross-v"],
					{
						strokeDashoffset: [80, 0],
						duration: 400,
						ease: "outBack",
					},
					"-=300"
				)
				.add(
					[
						"#hud-bracket-tl",
						"#hud-bracket-tr",
						"#hud-bracket-bl",
						"#hud-bracket-br",
					],
					{
						opacity: [0, 1, 0.2, 1],
						duration: 400,
						ease: steps(4),
						delay: stagger(60),
					},
					"-=200"
				)
				.add(
					"#hud-center-dot",
					{
						opacity: [0, 1],
						r: [0, 2],
						duration: 300,
						ease: "outBounce",
					},
					"-=100"
				)
				.add(
					"#hud-status",
					{
						opacity: [0, 0.6, 0, 0.4],
						duration: 500,
						ease: steps(4),
					},
					"-=200"
				)
				.add(
					"#hud-progress-track",
					{
						opacity: [0, 1],
						scaleX: [0, 1],
						duration: 400,
						ease: "outQuart",
					},
					"-=300"
				)
				.add("#hud-progress-fill", {
					width: ["0%", "100%"],
					duration: 700,
					ease: "inOutQuart",
				})
				// ── EXIT: lock → glitch → disassemble → burst ──

				// 1. Center-dot "lock-on" pulse
				.add("#hud-center-dot", {
					r: [2, 5, 2],
					opacity: [1, 0.3, 1],
					duration: 250,
					ease: "inOutQuad",
				})

				// 2. Status + progress retract
				.add(
					["#hud-status", "#hud-progress-track"],
					{
						opacity: [1, 0],
						scaleX: [1, 0],
						duration: 200,
						ease: "inQuart",
					},
					"-=100"
				)

				// 3. Crosshairs snap to zero length
				.add(
					["#hud-cross-h", "#hud-cross-v"],
					{
						strokeDashoffset: [0, 80],
						duration: 250,
						ease: "inBack",
					},
					"-=100"
				)

				// 4. Brackets fly outward to corners
				.add(
					"#hud-bracket-tl",
					{
						translateX: -30,
						translateY: -30,
						opacity: [1, 0],
						duration: 350,
						ease: "inQuart",
					},
					"-=150"
				)
				.add(
					"#hud-bracket-tr",
					{
						translateX: 30,
						translateY: -30,
						opacity: [1, 0],
						duration: 350,
						ease: "inQuart",
					},
					"-=350"
				)
				.add(
					"#hud-bracket-bl",
					{
						translateX: -30,
						translateY: 30,
						opacity: [1, 0],
						duration: 350,
						ease: "inQuart",
					},
					"-=350"
				)
				.add(
					"#hud-bracket-br",
					{
						translateX: 30,
						translateY: 30,
						opacity: [1, 0],
						duration: 350,
						ease: "inQuart",
					},
					"-=350"
				)

				// 5. Inner ring implodes, outer ring explodes
				.add(
					"#hud-ring-inner",
					{
						r: [40, 0],
						opacity: [1, 0],
						strokeWidth: [0.5, 3],
						duration: 300,
						ease: "inQuint",
					},
					"-=200"
				)
				.add(
					"#hud-ring-outer",
					{
						r: [56, 120],
						opacity: [1, 0],
						strokeWidth: [0.5, 0],
						duration: 400,
						ease: "outQuad",
					},
					"-=250"
				)

				// 6. Center dot detonates — scales up then vanishes
				.add(
					"#hud-center-dot",
					{
						r: [2, 40],
						opacity: [1, 0],
						duration: 350,
						ease: "outQuad",
					},
					"-=300"
				)

				// 7. Brief white flash on the whole reticle
				.add(
					"#hud-reticle",
					{
						opacity: [1, 0],
						scale: [1, 1.3],
						filter: ["brightness(1)", "brightness(8)"],
						duration: 250,
						ease: "outExpo",
					},
					"-=150"
				)

				// 8. Loader overlay sweep-out
				.add(
					"#page-loader",
					{
						opacity: [1, 0],
						duration: 400,
						ease: "inQuad",
					},
					"-=100"
				);
		</script>

		<!-- Scroll reveal observer -->
		<script>
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add("revealed");
							observer.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.05, rootMargin: "0px 0px -80px 0px" }
			);

			document
				.querySelectorAll(".reveal, .line-reveal")
				.forEach((el) => observer.observe(el));
		</script>

		<!-- Cloudflare Web Analytics -->
		<script
			is:inline
			defer
			src="https://static.cloudflareinsights.com/beacon.min.js"
			data-cf-beacon="{"
			token":"3fcbb74087d84e6382b5294ec7fce2be"}"
		></script>
	</body>
</html>
