---
import { SITE_NAME } from "../config";
import { socialLinks } from "../data";
---

<footer
	class="relative"
	aria-label="Footer"
	style="border-top: 1px solid var(--hairline); background: var(--canvas);"
>
	<!-- CTA Band — "Start Deploying" style black CTA band -->
	<div
		style="background: var(--canvas); padding: var(--space-4xl) var(--space-lg);"
	>
		<div style="max-width: 1200px; margin: 0 auto;">
			<div
				class="reveal"
				style="border: 1px solid var(--hairline); border-radius: var(--rounded-lg); padding: var(--space-3xl) var(--space-xl); text-align: center; position: relative; overflow: hidden; background: var(--canvas-elevated);"
			>
				<!-- Subtle mesh gradient behind CTA -->
				<div
					aria-hidden="true"
					style="position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse 70% 60% at 30% 50%, rgba(80,227,194,0.08) 0%, transparent 60%), radial-gradient(ellipse 50% 50% at 70% 50%, rgba(121,40,202,0.06) 0%, transparent 60%); z-index: 0;"
				>
				</div>

				<div style="position: relative; z-index: 1;">
					<p
						class="eyebrow"
						style="color: var(--text-mute); margin-bottom: var(--space-md);"
					>
						Hey, I'm looking for work
					</p>
					<h3
						style="font-family: var(--font-sans); font-size: clamp(1.75rem, 3vw + 1rem, 2.75rem); font-weight: 600; line-height: 1.1; letter-spacing: -0.04em; color: var(--text-ink); margin: 0 0 var(--space-md) 0;"
					>
						Got a hard problem? Let's talk.
					</h3>
					<p
						style="font-size: 1rem; line-height: 1.6; color: var(--text-body); max-width: 460px; margin: 0 auto var(--space-2xl) auto;"
					>
						I'm at my best when I'm untangling complex backend challenges — the kind where you need someone who actually cares about data consistency and uptime.
					</p>
					<div
						style="display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; align-items: center;"
					>
						<a
							href="mailto:sarveshrane2000@gmail.com"
							class="btn-primary cta-main-btn"
							id="footer-cta-btn"
						>
							Say Hello
						</a>
						<a
							href={socialLinks[0].link}
							target="_blank"
							rel="noopener noreferrer"
							class="btn-secondary cta-secondary-btn"
							id="footer-github-btn"
						>
							View GitHub
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Footer columns -->
	<div style="border-top: 1px solid var(--hairline);">
		<div
			style="max-width: 1200px; margin: 0 auto; padding: var(--space-3xl) var(--space-lg);"
		>
			<div
				class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-6 mb-12 reveal"
			>
				<!-- Brand column -->
				<div class="md:col-span-1">
					<p
						style="font-family: var(--font-mono); font-weight: 600; font-size: 0.9375rem; color: var(--text-ink); margin: 0 0 var(--space-sm) 0; letter-spacing: -0.03em;"
					>
						{SITE_NAME.split(".")[0].toLowerCase()}<span
							style="color: var(--text-mute);">.</span
						><span style="color: var(--text-faint);"
							>{SITE_NAME.split(".")[1]?.toLowerCase()}</span
						>
					</p>
					<p
						style="font-size: 0.875rem; line-height: 1.6; color: var(--text-mute); max-width: 200px; margin: 0;"
					>
						Systems-focused engineer who likes
						building things that don't break under
						pressure.
					</p>
				</div>

				<!-- Navigation -->
				<div>
					<p
						class="eyebrow"
						style="color: var(--text-mute); margin-bottom: var(--space-md);"
					>
						Navigation
					</p>
					<div
						style="display: flex; flex-direction: column; gap: 10px;"
					>
						<a
							href="#"
							class="footer-link"
							style="font-size: 0.875rem; color: var(--text-body); text-decoration: none;"
							>Home</a
						>
						<a
							href="#work-section"
							class="footer-link"
							style="font-size: 0.875rem; color: var(--text-body); text-decoration: none;"
							>Work</a
						>
						<a
							href="#about-section"
							class="footer-link"
							style="font-size: 0.875rem; color: var(--text-body); text-decoration: none;"
							>About</a
						>
					</div>
				</div>

				<!-- Connect -->
				<div>
					<p
						class="eyebrow"
						style="color: var(--text-mute); margin-bottom: var(--space-md);"
					>
						Connect
					</p>
					<div
						style="display: flex; flex-direction: column; gap: 10px;"
					>
						{
							socialLinks.map((social) => (
								<a
									href={social.link}
									target="_blank"
									rel="noopener noreferrer"
									class="footer-link"
									style="font-size: 0.875rem; color: var(--text-body); text-decoration: none;"
								>
									{social.title}
								</a>
							))
						}
					</div>
				</div>

				<!-- Status -->
				<div class="md:text-right">
					<p
						class="eyebrow"
						style="color: var(--text-mute); margin-bottom: var(--space-md);"
					>
						Status
					</p>
					<p
						style="font-size: 0.875rem; color: var(--text-body); margin: 0 0 4px 0;"
					>
						Navi Mumbai, IST
					</p>
					<p
						style="font-size: 0.875rem; color: var(--text-mute); margin: 0 0 var(--space-sm) 0;"
					>
						Ready for something new
					</p>
					<div
						style="display: flex; align-items: center; gap: 6px; justify-content: flex-end; line-height: 1;"
						class="md:justify-end justify-start"
					>
						<span
							style="width: 6px; height: 6px; border-radius: 50%; background: #22c55e; display: inline-block;"
							class="animate-pulse-slow"></span>
						<span class="eyebrow" style="color: var(--text-mute); line-height: 1;"
							>Open to work</span
						>
					</div>
				</div>
			</div>

			<!-- Bottom row -->
			<div
				style="height: 1px; background: var(--hairline); margin-bottom: var(--space-lg);"
			>
			</div>
			<div style="display: flex; flex-direction: column; gap: 8px;">
				<div
					class="flex flex-col md:flex-row md:items-center md:justify-between gap-2"
				>
					<p class="eyebrow" style="color: var(--text-faint);">
						&copy; {new Date().getFullYear()} Sarvesh Rane. All rights
						reserved.
					</p>
					<p
						class="eyebrow"
						style="color: var(--text-faint);"
						title="Deployed on Cloudflare Pages · CI via GitHub Actions"
					>
						Shipped to the edge · zero cold starts
					</p>
				</div>
			</div>
		</div>
	</div>
</footer>

<style>
	.footer-link {
		transition: color 150ms var(--ease-out);
	}
	@media (hover: hover) and (pointer: fine) {
		.footer-link:hover {
			color: var(--text-ink) !important;
		}
	}
	.footer-link:active {
		transform: scale(0.98);
	}

	.cta-main-btn,
	.cta-secondary-btn {
		transition:
			opacity 150ms var(--ease-out),
			transform 150ms var(--ease-out),
			background 150ms var(--ease-out),
			border-color 150ms var(--ease-out);
	}
</style>
