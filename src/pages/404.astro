---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Not Found">
	<section
		style="min-height: 100svh; display: flex; align-items: center; justify-content: center; padding: var(--space-lg); text-align: center;"
	>
		<div style="max-width: 560px;">
			<p class="eyebrow" style="margin: 0 0 var(--space-md) 0;">// 404 — not found</p>
			<h1
				style="font-family: var(--font-sans); font-size: clamp(3rem, 8vw, 6rem); font-weight: 700; letter-spacing: -0.05em; color: var(--text-ink); margin: 0 0 var(--space-md) 0;"
			>
				Lost in the stack.
			</h1>
			<p style="font-size: 1rem; color: var(--text-body); line-height: 1.6; margin: 0 0 var(--space-xl) 0;">
				The page you're looking for doesn't exist or was moved.
			</p>
			<a href="/" class="btn-primary">Back home ↗</a>
		</div>
	</section>
</Layout>