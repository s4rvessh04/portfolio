---
import { SITE_NAME } from "../config";
import Navlink from "./Navlink.astro";
import { socialLinks } from "../data";

const links = [
	{ href: "#work-section", label: "Work" },
	{ href: "#experience-section", label: "Experience" },
	{ href: "#about-section", label: "About" },
];
---

<nav
	class="fixed top-0 left-0 right-0 z-50"
	id="main-nav"
	aria-label="Primary navigation"
	style="opacity: 0; transform: translateY(-12px);"
>
	<div
		class="px-4 md:px-6 lg:px-8 flex items-center justify-between"
		style="height: 60px;"
	>
		<!-- Brand — wordmark only -->
		<a
			href="/"
			class="flex items-center font-semibold text-sm"
			style="color: var(--text-ink); text-decoration: none; letter-spacing: -0.03em; font-family: var(--font-mono);"
			aria-label="Home"
		>
			{SITE_NAME.split(".")[0].toLowerCase()}<span style="color: var(--text-mute);">.</span><span style="color: var(--text-faint);">{SITE_NAME.split(".")[1]?.toLowerCase()}</span>
		</a>

		<!-- Desktop nav -->
		<div class="hidden md:flex items-center gap-1">
			<ul class="flex items-center gap-1 mr-3" role="list">
				{
					links.map(({ href, label }) => (
						<Navlink href={href} label={label} />
					))
				}
			</ul>

			<!-- Nav CTA buttons -->
			<div class="flex items-center gap-2">
				<!-- Dark mode toggle -->
				<button
					id="theme-toggle"
					type="button"
					aria-label="Toggle dark mode"
					class="btn-nav"
					style="width: 32px; padding: 0; justify-content: center;"
				>
					<svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
					</svg>
					<svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
						<circle cx="12" cy="12" r="5"></circle>
						<line x1="12" y1="1" x2="12" y2="3"></line>
						<line x1="12" y1="21" x2="12" y2="23"></line>
						<line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
						<line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
						<line x1="1" y1="12" x2="3" y2="12"></line>
						<line x1="21" y1="12" x2="23" y2="12"></line>
						<line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
						<line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
					</svg>
				</button>
				<a
					href={socialLinks[0].link}
					target="_blank"
					rel="noopener noreferrer"
					class="btn-nav btn-nav-primary"
					id="nav-github-btn"
				>
					GitHub
				</a>
			</div>
		</div>

		<!-- Mobile: hamburger -->
		<div class="flex md:hidden items-center gap-2">
			<button
				id="menu-toggle"
				type="button"
				aria-label="Open menu"
				aria-expanded="false"
				class="relative w-9 h-9 flex items-center justify-center cursor-pointer"
				style="border: 1px solid var(--hairline); background: var(--canvas-elevated); border-radius: var(--rounded-sm); transition: background 200ms var(--ease-out), border-color 200ms var(--ease-out);"
			>
				<div class="hamburger-lines flex flex-col items-center justify-center gap-[5px]">
					<span class="block w-[14px] h-px" style="background: var(--text-ink); transition: transform 250ms var(--ease-out), opacity 150ms var(--ease-out);"></span>
					<span class="block w-[14px] h-px" style="background: var(--text-ink); transition: transform 250ms var(--ease-out), opacity 150ms var(--ease-out);"></span>
					<span class="block w-[10px] h-px self-start ml-[2px]" style="background: var(--text-mute); transition: transform 250ms var(--ease-out), opacity 150ms var(--ease-out);"></span>
				</div>
			</button>
		</div>
	</div>
</nav>

<!-- Mobile drawer overlay -->
<div
	id="mobile-drawer-overlay"
	class="fixed inset-0 z-40 pointer-events-none"
	style="background: rgba(0,0,0,0); transition: background 300ms var(--ease-out);"
	aria-hidden="true"
>
</div>

<!-- Mobile drawer -->
<aside
	id="mobile-drawer"
	class="fixed top-0 right-0 z-[45] h-full flex flex-col"
	style="width: min(85vw, 320px); background: var(--canvas-elevated); border-left: 1px solid var(--hairline); transform: translateX(100%); transition: transform 300ms var(--ease-out); will-change: transform;"
	aria-hidden="true"
>
	<!-- Drawer header -->
	<div
		class="flex items-center justify-between px-6 py-4"
		style="border-bottom: 1px solid var(--hairline); height: 60px;"
	>
		<span
			class="font-semibold text-sm"
			style="color: var(--text-ink); letter-spacing: -0.02em;"
		>Menu</span>
		<button
			id="drawer-close"
			type="button"
			aria-label="Close menu"
			class="w-9 h-9 flex items-center justify-center cursor-pointer"
			style="border: 1px solid var(--hairline); background: var(--canvas-elevated); border-radius: var(--rounded-sm); transition: background 200ms var(--ease-out);"
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				width="14"
				height="14"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				style="color: var(--text-ink);"
			>
				<line x1="18" y1="6" x2="6" y2="18"></line>
				<line x1="6" y1="6" x2="18" y2="18"></line>
			</svg>
		</button>
	</div>

	<!-- Drawer nav links -->
	<nav class="flex-1 flex flex-col px-4 pt-6 pb-6 overflow-y-auto">
		<ul class="flex flex-col gap-1 mb-8" role="list">
			{
				links.map(({ href, label }, idx) => (
					<li role="listitem">
						<a
							href={href}
							class="drawer-link flex items-center justify-between px-3 py-3 rounded-md"
							style={`color: var(--text-ink); text-decoration: none; font-size: 0.9375rem; font-weight: 500; letter-spacing: -0.01em; opacity: 0; transform: translateX(16px); transition: opacity 250ms var(--ease-out) ${
								60 + idx * 50
							}ms, transform 250ms var(--ease-out) ${
								60 + idx * 50
							}ms, background 150ms var(--ease-out);`}
						>
							<span>{label}</span>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="14"
								height="14"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								style="color: var(--text-mute);"
							>
								<line x1="5" y1="12" x2="19" y2="12" />
								<polyline points="12 5 19 12 12 19" />
							</svg>
						</a>
					</li>
				))
			}
			<li role="listitem">
				<a
					href="mailto:sarveshrane2000@gmail.com"
					class="drawer-link flex items-center justify-between px-3 py-3 rounded-md"
					style={`color: var(--text-ink); text-decoration: none; font-size: 0.9375rem; font-weight: 500; letter-spacing: -0.01em; opacity: 0; transform: translateX(16px); transition: opacity 250ms var(--ease-out) ${
						60 + links.length * 50
					}ms, transform 250ms var(--ease-out) ${
						60 + links.length * 50
					}ms, background 150ms var(--ease-out);`}
				>
					<span>Contact</span>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="14"
						height="14"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						style="color: var(--text-mute);"
					>
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
				</a>
			</li>
		</ul>

		<!-- Bottom CTA -->
		<div class="px-1 mt-auto">
			<a
				href={socialLinks[0].link}
				target="_blank"
				rel="noopener noreferrer"
				class="btn-primary w-full justify-center"
				style="display: flex;"
			>
				View GitHub
			</a>
		</div>
	</nav>
</aside>

<style>
	/* Hamburger hover */
	@media (hover: hover) and (pointer: fine) {
		#menu-toggle:hover,
		#drawer-close:hover {
			background: var(--hairline-soft) !important;
			border-color: var(--hover-border) !important;
		}
	}
	#menu-toggle:active,
	#drawer-close:active {
		transform: scale(0.95);
	}

	/* Drawer link hover */
	@media (hover: hover) and (pointer: fine) {
		.drawer-link:hover {
			background: var(--hairline-soft) !important;
		}
	}
	.drawer-link:active {
		background: var(--hairline-soft) !important;
	}
</style>

<script>
	// Dark mode toggle
	const html = document.documentElement;
	const toggle = document.getElementById('theme-toggle');
	const iconMoon = document.getElementById('icon-moon');
	const iconSun = document.getElementById('icon-sun');

	function getSystemTheme() {
		return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	}

	function applyTheme(theme: string) {
		html.setAttribute('data-theme', theme);
		localStorage.setItem('theme', theme);
		if (iconMoon && iconSun) {
			iconMoon.style.display = theme === 'dark' ? 'none' : 'block';
			iconSun.style.display = theme === 'dark' ? 'block' : 'none';
		}
	}

	// Init: respect stored preference, then OS preference
	const stored = localStorage.getItem('theme');
	applyTheme(stored ?? getSystemTheme());

	toggle?.addEventListener('click', () => {
		const current = html.getAttribute('data-theme') ?? getSystemTheme();
		applyTheme(current === 'dark' ? 'light' : 'dark');
	});
</script>

<script>
	// Dynamic navbar: transparent at top, frosted glass on scroll
	let navReady = false;
	function updateNav() {
		const nav = document.getElementById("main-nav");
		if (!nav) return;
		if (window.scrollY > 60) {
			nav.style.background = "var(--nav-bg)";
			nav.style.backdropFilter = "blur(12px) saturate(1.4)";
			nav.style.webkitBackdropFilter = "blur(12px) saturate(1.4)";
			nav.style.borderBottom = "1px solid var(--hairline)";
		} else {
			nav.style.background = "transparent";
			nav.style.backdropFilter = "none";
			nav.style.webkitBackdropFilter = "none";
			nav.style.borderBottom = "1px solid transparent";
		}
	}
	setTimeout(() => {
		const nav = document.getElementById("main-nav");
		if (nav) nav.classList.add("nav-ready");
		navReady = true;
		updateNav();
	}, 1200);
	window.addEventListener("scroll", () => {
		if (navReady) updateNav();
	}, { passive: true });

	// Mobile drawer logic
	const menuToggle = document.getElementById("menu-toggle");
	const drawerClose = document.getElementById("drawer-close");
	const drawer = document.getElementById("mobile-drawer");
	const overlay = document.getElementById("mobile-drawer-overlay");

	function openDrawer() {
		document.body.classList.add("menu-open");
		document.body.style.overflow = "hidden";
		if (drawer) {
			drawer.style.transform = "translateX(0)";
			drawer.setAttribute("aria-hidden", "false");
		}
		if (overlay) {
			overlay.style.background = "rgba(0,0,0,0.32)";
			overlay.style.pointerEvents = "auto";
		}
		if (menuToggle) menuToggle.setAttribute("aria-expanded", "true");
		document.querySelectorAll(".drawer-link").forEach((link) => {
			(link as HTMLElement).style.opacity = "1";
			(link as HTMLElement).style.transform = "translateX(0)";
		});
	}

	function closeDrawer() {
		document.body.classList.remove("menu-open");
		document.body.style.overflow = "";
		if (drawer) {
			drawer.style.transform = "translateX(100%)";
			drawer.setAttribute("aria-hidden", "true");
		}
		if (overlay) {
			overlay.style.background = "rgba(0,0,0,0)";
			overlay.style.pointerEvents = "none";
		}
		if (menuToggle) menuToggle.setAttribute("aria-expanded", "false");
		setTimeout(() => {
			document.querySelectorAll(".drawer-link").forEach((link) => {
				(link as HTMLElement).style.opacity = "0";
				(link as HTMLElement).style.transform = "translateX(16px)";
			});
		}, 300);
	}

	menuToggle?.addEventListener("click", () => {
		const isOpen = document.body.classList.contains("menu-open");
		isOpen ? closeDrawer() : openDrawer();
	});

	drawerClose?.addEventListener("click", closeDrawer);
	overlay?.addEventListener("click", closeDrawer);

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && document.body.classList.contains("menu-open")) {
			closeDrawer();
		}
	});

	document.querySelectorAll("#mobile-drawer a[href^='#']").forEach((link) => {
		link.addEventListener("click", () => {
			closeDrawer();
		});
	});

	// Focus trap inside mobile drawer
	document.addEventListener("keydown", (e) => {
		if (e.key !== "Tab" || !document.body.classList.contains("menu-open")) return;
		const focusable = drawer?.querySelectorAll<HTMLElement>(
			'a[href], button, input, textarea, select, [tabindex]:not([tabindex="-1"])'
		);
		if (!focusable || focusable.length === 0) return;
		const first = focusable[0];
		const last = focusable[focusable.length - 1];
		if (e.shiftKey && document.activeElement === first) {
			e.preventDefault();
			last.focus();
		} else if (!e.shiftKey && document.activeElement === last) {
			e.preventDefault();
			first.focus();
		}
	});
</script>
