---
import "../styles/global.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import Navbar from "../components/Navbar.astro";

import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

export interface Props {
	title?: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
	<head>
		<!-- Theme: detect system preference or saved choice before paint -->
		<script is:inline>
			(function () {
				var saved = localStorage.getItem("theme");
				var theme = saved
					? saved
					: window.matchMedia("(prefers-color-scheme: light)").matches
					? "light"
					: "dark";
				document.documentElement.setAttribute("data-theme", theme);
			})();
		</script>
		<GoogleAnalytics />
		<script>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({
					"gtm.start": new Date().getTime(),
					event: "gtm.js",
				});
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != "dataLayer" ? "&l=" + l : "";
				j.async = true;
				j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, "script", "dataLayer", "GTM-WW9MXB4S");
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={SITE_DESCRIPTION} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@200;300;400;500;600&family=Syne:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title ? title : SITE_TITLE}</title>
		<link rel="canonical" href={Astro.url} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title ? title : SITE_TITLE} />
		<meta property="og:description" content={SITE_DESCRIPTION} />
		<meta
			property="og:image"
			content={new URL("/profile.webp", Astro.url)}
		/>

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title ? title : SITE_TITLE} />
		<meta property="twitter:description" content={SITE_DESCRIPTION} />
		<meta
			property="twitter:image"
			content={new URL("/profile.webp", Astro.url)}
		/>
	</head>
	<body
		class="min-h-screen antialiased overflow-x-hidden"
		style="background-color: var(--bg); color: var(--fg); selection-background: var(--fg); selection-color: var(--bg);"
	>
		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-WW9MXB4S"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe>
		</noscript>

		<!-- ===========================
		     PAGE LOADER — HUD Reticle
		     =========================== -->
		<div
			id="page-loader"
			class="fixed inset-0 z-[100] flex flex-col items-center justify-center pointer-events-auto"
			style="background-color: var(--loader-bg);"
		>
			<div class="loader-scanlines"></div>
			<div class="relative flex flex-col items-center">
				<svg
					id="hud-reticle"
					width="120"
					height="120"
					viewBox="0 0 120 120"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
					style="opacity: 0;"
				>
					<circle
						id="hud-ring-outer"
						cx="60"
						cy="60"
						r="56"
						stroke="var(--fg-faint)"
						stroke-width="0.5"
						stroke-dasharray="352"
						stroke-dashoffset="352"></circle>
					<circle
						id="hud-ring-inner"
						cx="60"
						cy="60"
						r="40"
						stroke="var(--fg-subtle)"
						stroke-width="0.5"
						stroke-dasharray="251"
						stroke-dashoffset="251"></circle>
					<line
						id="hud-cross-h"
						x1="20"
						y1="60"
						x2="100"
						y2="60"
						stroke="var(--fg-subtle)"
						stroke-width="0.5"
						stroke-dasharray="80"
						stroke-dashoffset="80"></line>
					<line
						id="hud-cross-v"
						x1="60"
						y1="20"
						x2="60"
						y2="100"
						stroke="var(--fg-subtle)"
						stroke-width="0.5"
						stroke-dasharray="80"
						stroke-dashoffset="80"></line>
					<path
						id="hud-bracket-tl"
						d="M25 40 L25 25 L40 25"
						stroke="var(--fg)"
						stroke-width="1"
						fill="none"
						opacity="0"></path>
					<path
						id="hud-bracket-tr"
						d="M80 25 L95 25 L95 40"
						stroke="var(--fg)"
						stroke-width="1"
						fill="none"
						opacity="0"></path>
					<path
						id="hud-bracket-bl"
						d="M25 80 L25 95 L40 95"
						stroke="var(--fg)"
						stroke-width="1"
						fill="none"
						opacity="0"></path>
					<path
						id="hud-bracket-br"
						d="M80 95 L95 95 L95 80"
						stroke="var(--fg)"
						stroke-width="1"
						fill="none"
						opacity="0"></path>
					<circle
						id="hud-center-dot"
						cx="60"
						cy="60"
						r="2"
						fill="var(--fg)"
						opacity="0"></circle>
				</svg>
				<div class="mt-8 flex flex-col items-center gap-3">
					<p
						id="hud-status"
						class="text-micro uppercase tracking-[0.4em] font-light"
						style="opacity: 0; color: var(--fg-muted);"
					>
						<!-- Set by JS randomly -->
					</p>
					<div
						id="hud-progress-track"
						class="w-32 h-px relative overflow-hidden"
						style="opacity: 0; background-color: var(--fg-faint);"
					>
						<div
							id="hud-progress-fill"
							class="absolute inset-y-0 left-0"
							style="width: 0%; background-color: var(--accent);"
						>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Noise texture (global, subtle) -->
		<div
			class="fixed inset-0 pointer-events-none z-[2] opacity-[0.02]"
			style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 512 512%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.65%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22/%3E%3C/svg%3E');"
		>
		</div>

		<Navbar />
		<main class="relative z-[3]">
			<slot />
		</main>

		<style is:global>
			/* ============================================
			   HERO GRID — contained to hero section only
			   ============================================ */
			.hero-grid {
				position: absolute;
				inset: 0;
				pointer-events: none;
				z-index: 0;
			}
			.hero-grid-lines {
				position: absolute;
				inset: 0;
				background-image: linear-gradient(
						to right,
						var(--fg-faint) 1px,
						transparent 1px
					),
					linear-gradient(
						to bottom,
						var(--fg-faint) 1px,
						transparent 1px
					);
				background-size: 80px 80px;
				mask-image: radial-gradient(
					ellipse 70% 60% at 50% 40%,
					black 30%,
					transparent 70%
				);
				-webkit-mask-image: radial-gradient(
					ellipse 70% 60% at 50% 40%,
					black 30%,
					transparent 70%
				);
			}
			.hero-grid-glow {
				position: absolute;
				inset: 0;
			}

			/* ============================================
			   LOADER — HUD scanlines
			   ============================================ */
			.loader-scanlines {
				position: absolute;
				inset: 0;
				pointer-events: none;
				background: repeating-linear-gradient(
					0deg,
					transparent,
					transparent 2px,
					var(--fg-faint) 2px,
					var(--fg-faint) 4px
				);
				z-index: 1;
			}

/* ============================================
   SCROLL REVEAL SYSTEM — refined timing & easing
   ============================================ */
.reveal {
  opacity: 0;
  transform: translateY(20px) scale(0.99);
  transition:
    opacity 0.2s var(--ease-out),
    transform 0.2s var(--ease-out);
}

/* Anime.js inspired staggered reveals with grid options */
.reveal[data-stagger-grid],
.reveal[style*='--reveal-delay'] {
  transition-delay: calc(var(--reveal-delay, 0s) + 0.05s);
}

/* Revealed state */
.reveal.revealed {
  opacity: 1;
  transform: translateY(0) scale(1);
}

/* Line reveal with minimal delay */
.line-reveal {
  height: 1px;
  background: var(--fg-faint);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.2s var(--ease-out);
}

.line-reveal.revealed {
  transform: scaleX(1);
}

/* Anime.js inspired easing for specific cases - using their naming convention */
:root {
  --anime-ease-inOutQuad: cubic-bezier(0.455, 0.03, 0.515, 0.955);
  --anime-ease-inOutExpo: cubic-bezier(0.19, 1, 0.22, 1);
  --anime-ease-inOutCirc: cubic-bezier(0.075, 0.82, 0.165, 1);
}
			.reveal.revealed {
				opacity: 1;
				transform: translateY(0) scale(1);
			}

/* Stagger delays — minimal Apple-style (15-40ms between items) */
.stagger-1 { transition-delay: 0.015s; }
.stagger-2 { transition-delay: 0.03s; }
.stagger-3 { transition-delay: 0.045s; }
.stagger-4 { transition-delay: 0.06s; }
.stagger-5 { transition-delay: 0.075s; }
.stagger-6 { transition-delay: 0.09s; }
.stagger-7 { transition-delay: 0.105s; }
.stagger-8 { transition-delay: 0.12s; }

/* Horizontal line animation */
.line-reveal {
  height: 1px;
  background: var(--fg-faint);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.2s var(--ease-out);
}
			.line-reveal.revealed {
				transform: scaleX(1);
			}

			/* Scrollbar */
			::-webkit-scrollbar {
				width: 0px;
			}
			html {
				scrollbar-width: none;
			}

			/* ============================================
			   NAV — transitions only after entry animation
			   ============================================ */
			#main-nav.nav-ready {
				transition:
					background-color 200ms var(--ease-out),
					backdrop-filter 200ms var(--ease-out),
					-webkit-backdrop-filter 200ms var(--ease-out),
					border-color 200ms var(--ease-out);
			}

			/* ============================================
			   @starting-style — modern entry animations
			   ============================================ */
			@starting-style {
				.reveal {
					opacity: 0;
					transform: translateY(30px) scale(0.98);
				}
				.line-reveal {
					transform: scaleX(0);
				}
			}

			/* ============================================
			   Touch device hover protection
			   ============================================ */
			@media (hover: none) and (pointer: coarse) {
				.reveal {
					opacity: 1 !important;
					transform: none !important;
					transition: none !important;
				}
				.line-reveal {
					transform: scaleX(1) !important;
					transition: none !important;
				}
			}
		</style>

		<!-- HUD Loader animation (anime.js) -->
		<script>
			import { createTimeline, stagger, steps } from "animejs";
import { eases } from "animejs/easings/eases";

			const loader = document.getElementById("page-loader");
			const statusEl = document.getElementById("hud-status");

			// ── Single random techy status message ──
			const statusMessages = [
				"Resolving CDN Edge Nodes",
				"Negotiating TLS Handshake",
				"Fetching Assets from Origin",
				"Hydrating Components",
				"Establishing Secure Tunnel",
				"Compiling Shader Pipeline",
			];
			const randomMsg =
				statusMessages[
					Math.floor(Math.random() * statusMessages.length)
				];
			if (statusEl) statusEl.textContent = randomMsg;

			// ── Page entry animation (runs after loader) ──
			function animatePageEntry() {
				const entryTl = createTimeline({
					defaults: { ease: "outQuart" },
				});

				// Navbar slides down — faster, snappier
				entryTl
					.add("#main-nav", {
						opacity: [0, 1],
						translateY: [-20, 0],
						duration: 400,
					})
					// Hero name with bounce
					.add(
						".hero-animate:first-of-type",
						{
							opacity: [0, 1],
							translateY: [30, 0],
							duration: 600,
							easing: eases.outBounce,
						},
						"-=250"
					)
					// Other hero elements slide in smoothly
					.add(
						".hero-animate:not(:first-of-type)",
						{
							opacity: [0, 1],
							translateY: [20, 0],
							duration: 400,
							delay: stagger(50),
						},
						"-=400"
					)
					// Scroll indicator fades in last
					.add(
						".hero-scroll-indicator",
						{
							opacity: [0, 1],
							translateY: [15, 0],
							duration: 400,
						},
						"-=150"
					);
			}

			// ── Loader timeline (sped up ~40-50%) ──
			const loaderTl = createTimeline({
				defaults: { ease: "outExpo" },
				onComplete: () => {
					if (loader) {
						loader.style.display = "none";
						loader.style.pointerEvents = "none";
					}
					animatePageEntry();
				},
			});

			loaderTl
				.add("#hud-reticle", {
					opacity: [0, 1, 0.3, 1],
					duration: 300,
					ease: "inOutQuad",
				})
				.add(
					"#hud-ring-outer",
					{
						strokeDashoffset: [352, 0],
						duration: 450,
						ease: "inOutQuart",
					},
					"-=120"
				)
				.add(
					"#hud-ring-inner",
					{
						strokeDashoffset: [251, 0],
						duration: 350,
						ease: "outQuart",
					},
					"-=280"
				)
				.add(
					["#hud-cross-h", "#hud-cross-v"],
					{
						strokeDashoffset: [80, 0],
						duration: 250,
						ease: "outBack",
					},
					"-=180"
				)
				.add(
					[
						"#hud-bracket-tl",
						"#hud-bracket-tr",
						"#hud-bracket-bl",
						"#hud-bracket-br",
					],
					{
						opacity: [0, 1, 0.2, 1],
						duration: 250,
						ease: steps(4),
						delay: stagger(40),
					},
					"-=120"
				)
				.add(
					"#hud-center-dot",
					{
						opacity: [0, 1],
						r: [0, 2],
						duration: 200,
						ease: "outBounce",
					},
					"-=60"
				)
				.add(
					"#hud-status",
					{
						opacity: [0, 0.6, 0, 0.4],
						duration: 300,
						ease: steps(4),
					},
					"-=120"
				)
				.add(
					"#hud-progress-track",
					{
						opacity: [0, 1],
						scaleX: [0, 1],
						duration: 250,
						ease: "outQuart",
					},
					"-=180"
				)
				.add("#hud-progress-fill", {
					width: ["0%", "100%"],
					duration: 500,
					ease: "inOutQuart",
				})
				// ── EXIT: lock → glitch → disassemble → burst ──

				// 1. Center-dot "lock-on" pulse
				.add("#hud-center-dot", {
					r: [2, 5, 2],
					opacity: [1, 0.3, 1],
					duration: 180,
					ease: "inOutQuad",
				})

				// 2. Status + progress retract
				.add(
					["#hud-status", "#hud-progress-track"],
					{
						opacity: [1, 0],
						scaleX: [1, 0],
						duration: 150,
						ease: "inQuart",
					},
					"-=60"
				)

				// 3. Crosshairs snap to zero length
				.add(
					["#hud-cross-h", "#hud-cross-v"],
					{
						strokeDashoffset: [0, 80],
						duration: 180,
						ease: "inBack",
					},
					"-=60"
				)

				// 4. Brackets fly outward to corners
				.add(
					"#hud-bracket-tl",
					{
						translateX: -30,
						translateY: -30,
						opacity: [1, 0],
						duration: 250,
						ease: "inQuart",
					},
					"-=100"
				)
				.add(
					"#hud-bracket-tr",
					{
						translateX: 30,
						translateY: -30,
						opacity: [1, 0],
						duration: 250,
						ease: "inQuart",
					},
					"-=250"
				)
				.add(
					"#hud-bracket-bl",
					{
						translateX: -30,
						translateY: 30,
						opacity: [1, 0],
						duration: 250,
						ease: "inQuart",
					},
					"-=250"
				)
				.add(
					"#hud-bracket-br",
					{
						translateX: 30,
						translateY: 30,
						opacity: [1, 0],
						duration: 250,
						ease: "inQuart",
					},
					"-=250"
				)

				// 5. Inner ring implodes, outer ring explodes
				.add(
					"#hud-ring-inner",
					{
						r: [40, 0],
						opacity: [1, 0],
						strokeWidth: [0.5, 3],
						duration: 200,
						ease: "inQuint",
					},
					"-=140"
				)
				.add(
					"#hud-ring-outer",
					{
						r: [56, 120],
						opacity: [1, 0],
						strokeWidth: [0.5, 0],
						duration: 280,
						ease: "outQuad",
					},
					"-=160"
				)

				// 6. Center dot detonates — scales up then vanishes
				.add(
					"#hud-center-dot",
					{
						r: [2, 40],
						opacity: [1, 0],
						duration: 250,
						ease: "outQuad",
					},
					"-=200"
				)

				// 7. Brief white flash on the whole reticle
				.add(
					"#hud-reticle",
					{
						opacity: [1, 0],
						scale: [1, 1.3],
						filter: ["brightness(1)", "brightness(8)"],
						duration: 180,
						ease: "outExpo",
					},
					"-=100"
				)

				// 8. Loader overlay sweep-out
				.add(
					"#page-loader",
					{
						opacity: [1, 0],
						duration: 300,
						ease: "inQuad",
					},
					"-=60"
				);
		</script>

<!-- Scroll reveal observer with anime.js-inspired staggering -->
<script>
	// Anime.js-inspired stagger options for grid layouts
	const staggerOptions = {
		grid: [12, 1], // Default to single column for most sections
		from: "center",
		axis: "y" // Vertical staggering
	};

	// Enhanced stagger options for specific sections
	const skillsStaggerOptions = {
		grid: [2, 6], // 2 columns for skills
		from: "center",
		axis: "y"
	};

	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					const target = entry.target;
					
					// Check if element has grid stagger data
					if (target.classList.contains("reveal")) {
						// Add stagger delay based on position and section type
						const rect = target.getBoundingClientRect();
						const section = target.closest("section");
						
						let delay = 0;
						
						if (section && section.id === "skills-section") {
							// Grid-based stagger for skills section
							const row = Math.floor((target.offsetTop - section.offsetTop) / target.offsetHeight);
							const col = Math.floor((target.offsetLeft - section.offsetLeft) / target.offsetWidth);
							delay = (row * staggerOptions.grid[1] + col) * 0.03; // 30ms base delay
						} else {
							// Simple vertical stagger for other sections
							const index = Array.from(target.parentElement.children).indexOf(target);
							delay = index * 0.015; // 15ms base delay
						}
						
						// Apply CSS custom property for delay
						target.style.setProperty('--reveal-delay', `${delay}s`);
					}
					
					target.classList.add("revealed");
					observer.unobserve(target);
				}
			});
		},
		{ threshold: 0.05, rootMargin: "0px 0px -80px 0px" }
	);

	document
		.querySelectorAll(".reveal, .line-reveal")
		.forEach((el) => observer.observe(el));
</script>

		<!-- Cloudflare Web Analytics -->
		<script
			is:inline
			defer
			src="https://static.cloudflareinsights.com/beacon.min.js"
			data-cf-beacon="{"
			token":"3fcbb74087d84e6382b5294ec7fce2be"}"
		></script>
	</body>
</html>
